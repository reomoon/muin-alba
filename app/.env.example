# app/.env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# VS Code 실행 버튼 '우리동네무인알바' 가 --dart-define-from-file=.env 로 읽습니다.

# Supabase 대시보드 > Project Settings > API Keys
SUPABASE_URL=https://<프로젝트ID>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# 네이버 클라우드 플랫폼 > Maps > Application > 인증 정보 > Client ID (비워 두면 지도 대신 안내 상자)
NAVER_MAP_CLIENT_ID=
